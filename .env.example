# -----------------------------------------------------------------------------
# Carrito IoT Backend - environment variables (names only)
#
# Copy this file to `.env` and fill in the values. Never commit the real `.env`.
# The backend reads these through `config.py` and `server_final.py`.
# -----------------------------------------------------------------------------

# MySQL database (originally a MySQL instance on AWS RDS)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Native WebSocket server
WS_HOST=
WS_PORT=

# Public IP/host the ESP8266 connects to
PUBLIC_IP=
